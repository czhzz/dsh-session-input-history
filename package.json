{
  "name": "dsh-session-input-history",
  "version": "0.1.1",
  "description": "DSH 会话隔离的输入历史导航插件（纯 client 双面）：对话输入框中按 ↑/↓ 方向键遍历当前会话发送过的消息（shell history 式交互），浏览中编辑或发送即退出。与全局历史插件的区别是历史严格限定在当前会话内。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "input",
    "history",
    "navigation",
    "session"
  ],
  "author": "caozh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czhzz/dsh-session-input-history.git"
  },
  "bugs": {
    "url": "https://github.com/czhzz/dsh-session-input-history/issues"
  },
  "homepage": "https://github.com/czhzz/dsh-session-input-history#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "tsconfig.json",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "check:lib": "npm run build && git diff --exit-code -- lib/"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@deepseek-ai/cordis": "^4.0.2",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  }
}
